NEXT_PUBLIC_SUPABASE_URL=https://ggpwqhfwpmcmjuhdfhfs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Postgres connection string — used by `npm run db:migrate` (runs before `next dev`).
# Get it from: Dashboard -> Settings -> Database -> Connection string.
#   Transaction pooler:  postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Direct connection:   postgresql://postgres.YOUR_REF:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# Special chars in the password (e.g. / @ :) must be percent-encoded.
# Do not commit a real password; use a placeholder in this file.
SUPABASE_DB_CONNECTION_STRING=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
